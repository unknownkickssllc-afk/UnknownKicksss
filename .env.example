PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# Local: http://localhost:3000 — Production: https://your-app.vercel.app (no trailing slash)
BASE_URL=http://localhost:3000

# Supabase — https://fepxpoystmqllibfmgie.supabase.co
# Project Settings → API → Project URL + service_role key (secret)
SUPABASE_URL=https://fepxpoystmqllibfmgie.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe test keys — Dashboard → Developers → API keys (toggle Test mode)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Local dev: `npm run stripe:webhook` prints whsec_... — paste here
# Production: Dashboard → Webhooks → endpoint signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Default admin (change after first login via seed or DB)
ADMIN_EMAIL=admin@unknownkicks.com
ADMIN_PASSWORD=changeme123

# Commission default % when barber has no custom rate
DEFAULT_COMMISSION_RATE=10
