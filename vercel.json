{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 30,
      "includeFiles": "server/views/**"
    }
  }
}
