/**
 * @OnlyCurrentDoc
 * Unknown Kickss — paid website purchases to the Website Sales report.
 * Add as a separate file in the connected spreadsheet's bound Apps Script
 * project. Run installUnknownKickssWebsiteSales once using the private installer.
 * Existing inventory, expenses, consignment and manual sales tabs are untouched.
 * Keep this file ES5-compatible; the bound project must use Google's V8 runtime.
 * APIs: developers.google.com/apps-script/reference/{spreadsheet,properties,script,lock,url-fetch}
 */
var UK_WEB_SPREADSHEET_ID = '1b8IlcWscjViVLk_5eN0Wef3REYtwNl0zjy1_-j-koro';
var UK_WEB_EXPORT_ENDPOINT = '__WEBSITE_EXPORT_ENDPOINT__';
var UK_WEB_ACK_ENDPOINT = '__WEBSITE_ACK_ENDPOINT__';
var UK_WEB_SYNC_TOKEN = '__SYNC_TOKEN__';
var UK_WEB_TAB_NAME = 'Website Sales';
var UK_WEB_OWNER_KEY = 'UNKNOWN_KICKSS_WEBSITE_SALES_V1';
var UK_WEB_SHEET_PROPERTY = 'UK_WEB_MANAGED_SHEET_ID';
var UK_WEB_HEADER_ROW = 5;
var UK_WEB_MAX_ROWS = 10000;
var UK_WEB_HEADERS = ['Website sale ID','Order number','Order date (New York)','Payment status','Order status','Items','Units','Subtotal (USD)','Recorded total (USD)','Sales to count (USD)','Review note'];

function ukWebCheckConfiguration_() {
  var allowed = /^https:\/\/www\.unknownkickss\.co\/api\/integrations\/[a-zA-Z0-9/_-]+$/;
  if (!allowed.test(UK_WEB_EXPORT_ENDPOINT) || !allowed.test(UK_WEB_ACK_ENDPOINT) || UK_WEB_EXPORT_ENDPOINT === UK_WEB_ACK_ENDPOINT || UK_WEB_SYNC_TOKEN.length < 32) {
    throw new Error('Use the private website-sales installer generated by Business OS.');
  }
}
function ukWebSpreadsheet_() {
  var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet || spreadsheet.getId() !== UK_WEB_SPREADSHEET_ID) {
    throw new Error('Install website sales inside the connected Unknown Kickss spreadsheet.');
  }
  return spreadsheet;
}
function ukWebPost_(url, payload, expectReport) {
  var response;
  try {
    response = UrlFetchApp.fetch(url, {method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+UK_WEB_SYNC_TOKEN},payload:JSON.stringify(payload),muteHttpExceptions:true,followRedirects:false});
  } catch (_) { throw new Error('Website sales could not reach Business OS. The next scheduled run will retry.'); }
  var status = response.getResponseCode();
  if (status < 200 || status >= 300) throw new Error('Business OS rejected website sales (HTTP '+status+'). Check its spreadsheet connection.');
  if (!expectReport) return;
  var text = response.getContentText();
  if (typeof text !== 'string' || text.length > 10000000) throw new Error('Website sales report is too large. No spreadsheet values were changed.');
  try { return JSON.parse(text); }
  catch (_) { throw new Error('Business OS returned an unreadable website-sales report. No spreadsheet values were changed.'); }
}
function ukWebInvalidReport_() {
  throw new Error('Website sales report failed validation. No spreadsheet values were changed. Check Business OS before retrying.');
}
function ukWebInteger_(value, maximum) {
  return typeof value === 'number' && isFinite(value) && value >= 0 && Math.floor(value) === value && value <= maximum;
}
function ukWebValidateReport_(report) {
  if (!report || report.version !== 1 || report.spreadsheetId !== UK_WEB_SPREADSHEET_ID || report.tabName !== UK_WEB_TAB_NAME ||
      typeof report.generatedAt !== 'string' || !/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/.test(report.generatedAt) ||
      !isFinite(new Date(report.generatedAt).getTime()) || new Date(report.generatedAt).toISOString() !== report.generatedAt ||
      typeof report.hash !== 'string' || !/^[a-f0-9]{64}$/.test(report.hash) ||
      typeof report.receipt !== 'string' || report.receipt.length < 16 || report.receipt.length > 8192 ||
      !Array.isArray(report.headers) || report.headers.length !== UK_WEB_HEADERS.length ||
      !Array.isArray(report.rows) || report.rows.length > UK_WEB_MAX_ROWS ||
      !report.summary || !ukWebInteger_(report.summary.orderCount, report.rows.length) ||
      !ukWebInteger_(report.summary.reviewCount, report.rows.length) || report.summary.orderCount+report.summary.reviewCount !== report.rows.length) ukWebInvalidReport_();
  report.headers.forEach(function(header,index) { if (header !== UK_WEB_HEADERS[index]) ukWebInvalidReport_(); });
  var ids = {}, totalText = 0;
  report.rows.forEach(function(row) {
    if (!Array.isArray(row) || row.length !== UK_WEB_HEADERS.length || typeof row[0] !== 'string' || !/^website:[1-9][0-9]{0,15}$/.test(row[0]) || ids[row[0]]) ukWebInvalidReport_();
    ids[row[0]] = true;
    row.forEach(function(value,column) {
      if (column >= 6 && column <= 9) {
        if (value === '') return;
        if (typeof value !== 'number' || !isFinite(value) || value < 0 || value > 1000000000 || (column === 6 && Math.floor(value) !== value)) ukWebInvalidReport_();
      } else {
        if (typeof value !== 'string' || value.length > 5000) ukWebInvalidReport_();
        totalText += value.length;
        if (totalText > 5000000) ukWebInvalidReport_();
      }
    });
  });
  return report;
}
function ukWebSafeCell_(value) {
  // Remote product/order text must never become an executable sheet formula.
  return typeof value === 'string' && /^\s*[=+\-@]/.test(value) ? "'"+value : value;
}
function ukWebOwnedSheet_(spreadsheet) {
  var properties = PropertiesService.getScriptProperties();
  var boundId = properties.getProperty(UK_WEB_SHEET_PROPERTY);
  var sheets = spreadsheet.getSheets();
  var named = spreadsheet.getSheetByName(UK_WEB_TAB_NAME);
  var sheet;
  if (boundId) {
    sheets.forEach(function(candidate) { if (String(candidate.getSheetId()) === boundId) sheet = candidate; });
    if (!sheet || sheet.getName() !== UK_WEB_TAB_NAME || (named && named.getSheetId() !== sheet.getSheetId())) {
      throw new Error('The managed Website Sales tab is missing or renamed. Restore that tab before syncing. No other tab was changed.');
    }
    return sheet;
  }
  if (named) {
    var expected = UK_WEB_SPREADSHEET_ID+':'+named.getSheetId();
    var owned = named.getDeveloperMetadata().some(function(metadata) { return metadata.getKey() === UK_WEB_OWNER_KEY && metadata.getValue() === expected; });
    if (!owned) throw new Error('A Website Sales tab already exists and is not owned by this sync. Rename that existing tab before installing; no cells were changed.');
    // Recover when sheet creation/metadata succeeded but a previous install
    // stopped before saving its property. Copied sheets have a different ID.
    properties.setProperty(UK_WEB_SHEET_PROPERTY, String(named.getSheetId()));
    return named;
  }
  sheet = spreadsheet.insertSheet(UK_WEB_TAB_NAME);
  sheet.addDeveloperMetadata(UK_WEB_OWNER_KEY, UK_WEB_SPREADSHEET_ID+':'+sheet.getSheetId());
  properties.setProperty(UK_WEB_SHEET_PROPERTY, String(sheet.getSheetId()));
  return sheet;
}
function ukWebBlankRow_() { return UK_WEB_HEADERS.map(function() { return ''; }); }
function ukWebWriteReport_(sheet, report) {
  var previousLast = sheet.getLastRow();
  if (previousLast > UK_WEB_MAX_ROWS+UK_WEB_HEADER_ROW) throw new Error('The Website Sales tab contains unexpected extra rows. Review it before retrying.');
  var requiredRows = Math.max(UK_WEB_HEADER_ROW+report.rows.length, previousLast, UK_WEB_HEADER_ROW+1);
  var values = [];
  var instructions = [
    'Website Sales — automatic report',
    'Do not edit this tab. Website purchases refresh automatically about every 5 minutes.',
    'Last updated (New York): '+Utilities.formatDate(new Date(), 'America/New_York', 'yyyy-MM-dd HH:mm:ss')+' | '+report.summary.orderCount+' counted sales | '+report.summary.reviewCount+' need review',
    'Enter Instagram, cash and other sales in your usual sheets. Check Review note; this report does not calculate profit.'
  ];
  instructions.forEach(function(instruction) { var row=ukWebBlankRow_(); row[0]=instruction; values.push(row); });
  values.push(report.headers.map(ukWebSafeCell_));
  report.rows.forEach(function(row) { values.push(row.map(ukWebSafeCell_)); });
  while (values.length < requiredRows) values.push(ukWebBlankRow_());
  if (sheet.getMaxRows() < requiredRows) sheet.insertRowsAfter(sheet.getMaxRows(), requiredRows-sheet.getMaxRows());
  if (sheet.getMaxColumns() < UK_WEB_HEADERS.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), UK_WEB_HEADERS.length-sheet.getMaxColumns());
  // One rectangular replacement also blanks removed orders from the previous
  // report; retries cannot append duplicates or leave an old paid sale behind.
  sheet.getRange(1,1,requiredRows,UK_WEB_HEADERS.length).setValues(values);
  sheet.getRange(1,1,4,UK_WEB_HEADERS.length).setFontColor('#202124').setFontSize(10).setWrap(false);
  sheet.getRange(1,1).setFontSize(14).setFontWeight('bold');
  sheet.getRange(UK_WEB_HEADER_ROW,1,1,UK_WEB_HEADERS.length).setBackground('#f1f3f4').setFontColor('#202124').setFontWeight('bold').setWrap(true);
  var dataHeight = requiredRows-UK_WEB_HEADER_ROW;
  sheet.getRange(UK_WEB_HEADER_ROW+1,1,dataHeight,UK_WEB_HEADERS.length).setVerticalAlignment('top');
  sheet.getRange(UK_WEB_HEADER_ROW+1,6,dataHeight,1).setWrap(true);
  sheet.getRange(UK_WEB_HEADER_ROW+1,11,dataHeight,1).setWrap(true);
  sheet.getRange(UK_WEB_HEADER_ROW+1,7,dataHeight,1).setNumberFormat('0');
  sheet.getRange(UK_WEB_HEADER_ROW+1,8,dataHeight,3).setNumberFormat('$#,##0.00;($#,##0.00)');
  var widths = [170,140,175,125,125,360,70,130,145,145,420];
  widths.forEach(function(width,index) { sheet.setColumnWidth(index+1,width); });
  sheet.setRowHeights(1,4,25);
  sheet.setFrozenRows(UK_WEB_HEADER_ROW);
  sheet.setFrozenColumns(2);
  var filter = sheet.getFilter();
  if (filter) filter.remove();
  sheet.getRange(UK_WEB_HEADER_ROW,1,Math.max(report.rows.length+1,2),UK_WEB_HEADERS.length).createFilter();
}
function syncUnknownKickssWebsiteSales() {
  ukWebCheckConfiguration_();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return false;
  try {
    var spreadsheet = ukWebSpreadsheet_();
    var report = ukWebValidateReport_(ukWebPost_(UK_WEB_EXPORT_ENDPOINT, {spreadsheetId:UK_WEB_SPREADSHEET_ID}, true));
    var sheet = ukWebOwnedSheet_(spreadsheet);
    ukWebWriteReport_(sheet, report);
    SpreadsheetApp.flush();
    // Only a completed sheet write may be acknowledged as delivered. On an
    // ACK failure the next full replacement safely retries the same report.
    ukWebPost_(UK_WEB_ACK_ENDPOINT, {spreadsheetId:UK_WEB_SPREADSHEET_ID,receipt:report.receipt,sheetId:sheet.getSheetId()}, false);
    return true;
  } finally { lock.releaseLock(); }
}
function installUnknownKickssWebsiteSales() {
  // Do not replace any existing timer until the report was written and ACKed.
  if (!syncUnknownKickssWebsiteSales()) throw new Error('Another spreadsheet sync is running. Run the website-sales installer again shortly.');
  var previous = ScriptApp.getProjectTriggers().filter(function(trigger) { return trigger.getHandlerFunction() === 'syncUnknownKickssWebsiteSales'; });
  // Create first so a Google trigger-creation failure leaves the old timer.
  ScriptApp.newTrigger('syncUnknownKickssWebsiteSales').timeBased().everyMinutes(5).create();
  previous.forEach(function(trigger) { ScriptApp.deleteTrigger(trigger); });
}
