/**
 * @OnlyCurrentDoc
 * Unknown Kickss — read-only spreadsheet snapshots.
 * Paste the private installer from Business OS into this spreadsheet's bound
 * Apps Script project, then run installUnknownKickssSync once and authorize it.
 * This script never writes cells, adds columns, or changes historical imports.
 * Reference: developers.google.com/apps-script/reference/{spreadsheet,script,lock,url-fetch}
 */
const UK_SPREADSHEET_ID = '1b8IlcWscjViVLk_5eN0Wef3REYtwNl0zjy1_-j-koro';
const UK_SYNC_ENDPOINT = '__SHEET_SYNC_ENDPOINT__';
const UK_PROCESS_ENDPOINT = '__PROCESS_ENDPOINT__';
const UK_SYNC_TOKEN = '__SYNC_TOKEN__';
const UK_MAX_TABS = 20;
const UK_MAX_ROWS = 2000;
const UK_MAX_SCAN_ROWS = 20000;
const UK_MAX_SCAN_CELLS = 1000000;
const UK_CHUNK_ROWS = 1000;
const UK_REQUIRED_TABS = [
  {id:72108132,title:'May 2026',expenses:false},
  {id:1515861308,title:'June 2026',expenses:false},
  {id:295653990,title:'July 2026',expenses:false},
  {id:1849494495,title:'August & September 2026',expenses:false},
  {id:1402387966,title:'Expenses',expenses:true}
];

function ukSpreadsheet_() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet || spreadsheet.getId() !== UK_SPREADSHEET_ID) {
    throw new Error('Install this script inside the connected Unknown Kickss spreadsheet.');
  }
  return spreadsheet;
}
function ukCheckConfiguration_() {
  const allowed = /^https:\/\/www\.unknownkickss\.co\/api\/integrations\/[a-zA-Z0-9/_-]+$/;
  if (!allowed.test(UK_SYNC_ENDPOINT) || !allowed.test(UK_PROCESS_ENDPOINT) || UK_SYNC_TOKEN.length < 32) {
    throw new Error('Use the private installer generated by Business OS.');
  }
}
function installUnknownKickssSync() {
  ukCheckConfiguration_();
  const spreadsheet = ukSpreadsheet_();
  // Verify a complete snapshot can reach the server before replacing triggers.
  syncUnknownKickss();
  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (['syncUnknownKickss', 'onUnknownKickssEdit'].indexOf(trigger.getHandlerFunction()) !== -1) ScriptApp.deleteTrigger(trigger);
  });
  ScriptApp.newTrigger('syncUnknownKickss').timeBased().everyMinutes(15).create();
  ScriptApp.newTrigger('onUnknownKickssEdit').forSpreadsheet(spreadsheet).onEdit().create();
}
function onUnknownKickssEdit(event) {
  if (!event || !event.source || event.source.getId() !== UK_SPREADSHEET_ID) return;
  const sheet = event.range && event.range.getSheet();
  const known = sheet && UK_REQUIRED_TABS.some(function(tab){return tab.id === sheet.getSheetId();});
  if (sheet && !known && sheet.getName().trim().toLowerCase() !== 'expenses' && ukHeader_(sheet.getRange(1,1).getValue()) !== 'item name') return;
  syncUnknownKickss();
}
function ukBlank_(value) { return value === null || value === '' || (typeof value === 'string' && value.trim() === ''); }
function ukHeader_(value) { return typeof value === 'string' ? value.trim().toLowerCase().replace(/\s+/g,' ') : ''; }
function ukValidateInventoryHeaders_(values) {
  const expected = [[0,['item name']],[4,['cost of goods sold','sale price']],[5,['quantity']],[7,['cost of goods']],[8,['net profit']]];
  if (expected.some(function(rule){return rule[1].indexOf(ukHeader_(values[rule[0]])) === -1;})) throw new Error('Sync stopped: inventory columns changed. Restore A Item Name, E Cost of Goods Sold or Sale price, F Quantity, H Cost of Goods, and I Net Profit.');
}
function ukMeaningfulItem_(values) {
  // Keep unnamed inventory with actual data; skip empty prefilled formula rows.
  return [0,1,4,5,7].some(function(index) { return !ukBlank_(values[index]); });
}
function ukCell_(value, timeZone) {
  return value instanceof Date ? Utilities.formatDate(value,timeZone,'yyyy-MM-dd') : value;
}
function ukCapture_(spreadsheet) {
  const timeZone = spreadsheet.getSpreadsheetTimeZone();
  const tabs = spreadsheet.getSheets();
  if (tabs.length > UK_MAX_TABS) throw new Error('Sync stopped: the workbook exceeds the 20-tab safety limit. No partial snapshot was sent.');
  const sheets = [];
  let scannedCells = 0;
  UK_REQUIRED_TABS.forEach(function(required) {
    if (!tabs.some(function(sheet){return sheet.getSheetId() === required.id;})) {
      throw new Error('Sync stopped: a required source tab is missing. Restore '+required.title+' before syncing. No partial snapshot was sent.');
    }
  });
  function countRead(height,width) {
    scannedCells += height*width;
    if (scannedCells > UK_MAX_SCAN_CELLS) throw new Error('Sync stopped: the workbook exceeds the 1,000,000-cell read limit. No partial snapshot was sent.');
  }
  tabs.forEach(function(sheet) {
    const title = sheet.getName(), required = UK_REQUIRED_TABS.find(function(tab){return tab.id === sheet.getSheetId();});
    const expenses = title.trim().toLowerCase() === 'expenses';
    if (required && required.expenses && !expenses) throw new Error('Sync stopped: the required Expenses tab was renamed. Restore its name before syncing.');
    countRead(1,1);
    const inventoryHeader = ukHeader_(sheet.getRange(1,1).getValue()) === 'item name';
    if (required && !required.expenses && !inventoryHeader) throw new Error('Sync stopped: '+required.title+' must retain its Item Name header in A1. No partial snapshot was sent.');
    if (!expenses && !inventoryHeader) return;
    const lastRow = sheet.getLastRow();
    if (lastRow > UK_MAX_SCAN_ROWS) throw new Error('Sync stopped: a source tab exceeds row 20000. No partial snapshot was sent.');
    const firstRow = expenses ? 7 : 1, width = expenses ? 5 : 12, rows = [];
    for (let start = firstRow; start <= lastRow; start += UK_CHUNK_ROWS) {
      const height = Math.min(UK_CHUNK_ROWS,lastRow-start+1), range = sheet.getRange(start,1,height,width);
      countRead(height,width);
      const values = range.getValues(), selected = [];
      values.forEach(function(cells,index) {
        const row = start+index;
        if (!expenses && row === 1) ukValidateInventoryHeaders_(cells);
        if (expenses ? cells.every(ukBlank_) : row !== 1 && !ukMeaningfulItem_(cells)) return;
        if (row > UK_MAX_ROWS || rows.length+selected.length >= UK_MAX_ROWS) throw new Error('Sync stopped: meaningful source data exceeds row 2000 or 2000 captured rows. No partial snapshot was sent.');
        selected.push(index);
      });
      // Formula-only tails still get fully checked, without a second display read.
      if (selected.length) {
        countRead(height,width);
        const display = range.getDisplayValues();
        selected.forEach(function(index){rows.push({row:start+index,values:values[index].map(function(value){return ukCell_(value,timeZone);}),display:display[index]});});
      }
    }
    sheets.push({id:sheet.getSheetId(),title:title,rows:rows});
  });
  if (!sheets.length) throw new Error('Sync stopped: no supported inventory or Expenses tabs were found.');
  return {spreadsheetId:spreadsheet.getId(),title:spreadsheet.getName(),capturedAt:new Date().toISOString(),timeZone:timeZone,sheets:sheets};
}
function ukPost_(url,payload) {
  let response;
  try {
    response = UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+UK_SYNC_TOKEN},payload:JSON.stringify(payload),muteHttpExceptions:true,followRedirects:false});
  } catch (_) { throw new Error('Sync could not reach Business OS. It will retry automatically.'); }
  const status = response.getResponseCode();
  if (status < 200 || status >= 300) throw new Error('Business OS rejected the sync (HTTP '+status+'). Check the connection in Business OS; no source cells were changed.');
}
function syncUnknownKickss() {
  ukCheckConfiguration_();
  const lock = LockService.getScriptLock();
  // Acquire before reading so an older capture cannot overtake a newer one.
  if (!lock.tryLock(1000)) return;
  try {
    const spreadsheet = ukSpreadsheet_();
    ukPost_(UK_SYNC_ENDPOINT,ukCapture_(spreadsheet));
    // Retry queued DM work even when the spreadsheet snapshot is unchanged.
    ukPost_(UK_PROCESS_ENDPOINT,{});
  } finally { lock.releaseLock(); }
}
